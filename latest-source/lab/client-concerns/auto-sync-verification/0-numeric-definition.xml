<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Household Mapping Verification (fictional)</h:title><model odk:xforms-version="1.0.0"><instance><data id="nsipa_household_mapping_check" version="2026111001"><start/><end/><deviceid/><collector_username/><visit><demo_notice/><enumerator_id/><visit_date/><consent/><no_consent/></visit><location><state/><lga/><ward/><coordinates/></location><household><household_name/><household_head_name/><sample_reference/><household_size/><children/><shelter/><roof_material/><water_source_type/></household><livelihood><livelihood_type/><priority_needs/><notes/></livelihood><review><summary/><review_confirmation/></review><next_steps/><meta><instanceID/><instanceName/></meta></data></instance><instance id="consent"><root><item><name>yes</name><label>Yes</label></item><item><name>no</name><label>No</label></item></root></instance><instance id="shelter"><root><item><name>owned</name><label>Owned</label></item><item><name>rented</name><label>Rented</label></item><item><name>shared</name><label>Shared or hosted</label></item><item><name>other</name><label>Other</label></item></root></instance><instance id="livelihood"><root><item><name>agriculture</name><label>Agriculture</label></item><item><name>wage</name><label>Wage work</label></item><item><name>self_employed</name><label>Self-employment</label></item><item><name>none</name><label>No current livelihood</label></item><item><name>other</name><label>Other</label></item></root></instance><instance id="needs"><root><item><name>food</name><label>Food support</label></item><item><name>education</name><label>Education</label></item><item><name>livelihood</name><label>Livelihoods</label></item><item><name>housing</name><label>Housing</label></item><item><name>other</name><label>Other</label></item></root></instance><instance id="confirm"><root><item><name>yes</name><label>Reviewed and confirmed</label></item><item><name>no</name><label>Not yet</label></item></root></instance><instance id="roof_material"><root><item><name>1</name><label>Thatch</label></item><item><name>2</name><label>Corrugated iron</label></item><item><name>3</name><label>Concrete</label></item><item><name>4</name><label>Tile</label></item><item><name>5</name><label>Plastic sheet</label></item><item><name>6</name><label>Other</label></item></root></instance><instance id="water_source_type"><root><item><name>1</name><label>Piped</label></item><item><name>2</name><label>Public tap</label></item><item><name>3</name><label>Well</label></item><item><name>4</name><label>Spring</label></item><item><name>5</name><label>Surface water</label></item><item><name>6</name><label>Rainwater</label></item><item><name>7</name><label>Tanker truck</label></item><item><name>8</name><label>Other</label></item></root></instance><bind nodeset="/data/start" jr:preload="timestamp" type="dateTime" jr:preloadParams="start"/><bind nodeset="/data/end" jr:preload="timestamp" type="dateTime" jr:preloadParams="end"/><bind nodeset="/data/deviceid" jr:preload="property" type="string" jr:preloadParams="deviceid"/><bind nodeset="/data/collector_username" jr:preload="property" type="string" jr:preloadParams="username"/><bind nodeset="/data/visit/demo_notice" readonly="true()" type="string"/><bind nodeset="/data/visit/enumerator_id" type="string" required="true()"/><bind nodeset="/data/visit/visit_date" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="Visit date cannot be in the future."/><bind nodeset="/data/visit/consent" type="string" required="true()"/><bind nodeset="/data/visit/no_consent" readonly="true()" type="string" relevant=" /data/visit/consent  = &quot;no&quot;"/><bind nodeset="/data/location" relevant=" /data/visit/consent  = &quot;yes&quot;"/><bind nodeset="/data/location/state" type="string" required="true()"/><bind nodeset="/data/location/lga" type="string" required="true()"/><bind nodeset="/data/location/ward" type="string" required="true()"/><bind nodeset="/data/location/coordinates" type="geopoint"/><bind nodeset="/data/household" relevant=" /data/visit/consent  = &quot;yes&quot;"/><bind nodeset="/data/household/household_name" type="string" required="true()"/><bind nodeset="/data/household/household_head_name" type="string" required="true()"/><bind nodeset="/data/household/sample_reference" type="string" required="true()"/><bind nodeset="/data/household/household_size" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 40" jr:constraintMsg="Enter a number from 1 to 40."/><bind nodeset="/data/household/children" type="int" required="true()" constraint=". &gt;= 0 and . &lt;=  /data/household/household_size " jr:constraintMsg="Enter a number no greater than household size."/><bind nodeset="/data/household/shelter" type="string" required="true()"/><bind nodeset="/data/household/roof_material" type="string"/><bind nodeset="/data/household/water_source_type" type="string"/><bind nodeset="/data/livelihood" relevant=" /data/visit/consent  = &quot;yes&quot;"/><bind nodeset="/data/livelihood/livelihood_type" type="string" required="true()"/><bind nodeset="/data/livelihood/priority_needs" type="string" required="true()"/><bind nodeset="/data/livelihood/notes" type="string"/><bind nodeset="/data/review" relevant=" /data/visit/consent  = &quot;yes&quot;"/><bind nodeset="/data/review/summary" readonly="true()" type="string"/><bind nodeset="/data/review/review_confirmation" type="string" required="true()" constraint=". = &quot;yes&quot;" jr:constraintMsg="Review the completed draft before confirming."/><bind nodeset="/data/next_steps" readonly="true()" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/><bind nodeset="/data/meta/instanceName" type="string" calculate="concat( /data/household/household_head_name , ' - ',  /data/household/sample_reference )"/></model></h:head><h:body><group appearance="field-list" ref="/data/visit"><label>1. Visit and consent</label><input ref="/data/visit/demo_notice"><label>DEMONSTRATION ONLY: enter fictional sample information. Do not collect national identity numbers, financial account numbers, medical details or real personal data.</label></input><input ref="/data/visit/enumerator_id"><label>Enumerator ID</label><hint>Use your assigned field ID.</hint></input><input ref="/data/visit/visit_date"><label>Visit date</label></input><select1 ref="/data/visit/consent"><label>Has the household agreed to this interview?</label><hint>Explain the purpose and voluntary nature before proceeding.</hint><itemset nodeset="instance('consent')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/visit/no_consent"><label>Consent was not given. Do not collect household details; end this interview.</label></input></group><group appearance="field-list" ref="/data/location"><label>2. Location</label><input ref="/data/location/state"><label>State or FCT</label><hint>Enter the state name.</hint></input><input ref="/data/location/lga"><label>Local government area</label><hint>Enter the LGA name.</hint></input><input ref="/data/location/ward"><label>Ward or community</label><hint>Enter the locally used name.</hint></input><input ref="/data/location/coordinates"><label>Location (optional)</label><hint>Capture only when appropriate and with permission.</hint></input></group><group appearance="field-list" ref="/data/household"><label>3. Household</label><input ref="/data/household/household_name"><label>Household name</label><hint>Enter a fictional household name for this demonstration.</hint></input><input ref="/data/household/household_head_name"><label>Household head name</label><hint>Enter a fictional head name for this demonstration.</hint></input><input ref="/data/household/sample_reference"><label>Sample household reference</label><hint>Use a non-identifying sample code.</hint></input><input ref="/data/household/household_size"><label>Number of household members</label></input><input ref="/data/household/children"><label>Number of children under 18</label></input><select1 ref="/data/household/shelter"><label>Main shelter type</label><itemset nodeset="instance('shelter')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/household/roof_material"><label>Roof material</label><hint>Controlled verification choice list.</hint><itemset nodeset="instance('roof_material')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/household/water_source_type"><label>Water source</label><hint>Controlled verification choice list.</hint><itemset nodeset="instance('water_source_type')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group appearance="field-list" ref="/data/livelihood"><label>4. Livelihood and needs</label><select1 ref="/data/livelihood/livelihood_type"><label>Main livelihood</label><itemset nodeset="instance('livelihood')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select ref="/data/livelihood/priority_needs"><label>Priority support needs</label><hint>Choose all that apply.</hint><itemset nodeset="instance('needs')/root/item"><value ref="name"/><label ref="label"/></itemset></select><input ref="/data/livelihood/notes"><label>Additional non-sensitive notes (optional)</label><hint>Do not include names, identity numbers or medical details.</hint></input></group><group appearance="field-list" ref="/data/review"><label>5. Review and confirmation</label><input ref="/data/review/summary"><label> Review: <output value=" /data/household/household_name "/>, head <output value=" /data/household/household_head_name "/>, reference <output value=" /data/household/sample_reference "/> in <output value=" /data/location/ward "/>, <output value=" /data/location/lga "/>, <output value=" /data/location/state "/>. Household members: <output value=" /data/household/household_size "/>; children: <output value=" /data/household/children "/>. </label></input><select1 ref="/data/review/review_confirmation"><label>Has the completed sample form been reviewed and confirmed?</label><hint>This is an on-device confirmation, not verified independent supervisor approval.</hint><itemset nodeset="instance('confirm')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><input ref="/data/next_steps"><label>To pause, save as draft. After review, finalize to keep the form on the device. Send finalized forms when online. Server review is separate.</label></input></h:body></h:html>
