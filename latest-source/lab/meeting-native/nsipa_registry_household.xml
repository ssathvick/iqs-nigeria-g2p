<?xml version='1.0' encoding='utf-8'?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa"><h:head><h:title>NSIPA Master Registry Household Interview</h:title><model><instance><data xmlns="" id="nsipa_registry_household" version="2026111201"><visit><sponsor_name /><respondent_name /><enumerator_name /><consent_status /><survey_community /></visit><household><record_name /><address_line_1 /><coordinates /></household><members jr:template=""><first_name /><last_name /><gender /><birth_date /><estimated_age /><relationship_to_head /><foundational_id /></members><living><rooms_count /><monthly_household_income /><income_source /><health_insurance_status /><tenure_status /></living><assets jr:template=""><asset_type /><asset_category /><quantity /></assets><review><confirmation /></review><meta><instanceID /></meta></data></instance><bind nodeset="/data/visit/sponsor_name" type="string" required="true()" /><bind nodeset="/data/visit/respondent_name" type="string" required="true()" /><bind nodeset="/data/visit/enumerator_name" type="string" required="true()" /><bind nodeset="/data/visit/consent_status" type="string" required="true()" constraint=". = 'YES'" jr:constraintMsg="Check this answer before continuing." /><bind nodeset="/data/visit/survey_community" type="string" /><bind nodeset="/data/household/record_name" type="string" required="true()" /><bind nodeset="/data/household/address_line_1" type="string" /><bind nodeset="/data/household/coordinates" type="geopoint" /><bind nodeset="/data/members/first_name" type="string" required="true()" /><bind nodeset="/data/members/last_name" type="string" required="true()" /><bind nodeset="/data/members/gender" type="string" required="true()" /><bind nodeset="/data/members/birth_date" type="date" /><bind nodeset="/data/members/estimated_age" type="int" required="string-length(../birth_date) = 0" constraint=". &gt;= 0 and . &lt;= 120" jr:constraintMsg="Check this answer before continuing." /><bind nodeset="/data/members/relationship_to_head" type="string" required="true()" /><bind nodeset="/data/members/foundational_id" type="string" /><bind nodeset="/data/living/rooms_count" type="int" constraint=". &gt;= 0" jr:constraintMsg="Check this answer before continuing." /><bind nodeset="/data/living/monthly_household_income" type="decimal" constraint=". &gt;= 0" jr:constraintMsg="Check this answer before continuing." /><bind nodeset="/data/living/income_source" type="string" /><bind nodeset="/data/living/health_insurance_status" type="string" /><bind nodeset="/data/living/tenure_status" type="string" /><bind nodeset="/data/assets/asset_type" type="string" required="true()" /><bind nodeset="/data/assets/asset_category" type="string" /><bind nodeset="/data/assets/quantity" type="int" constraint=". &gt;= 0" jr:constraintMsg="Check this answer before continuing." /><bind nodeset="/data/review/confirmation" type="string" required="true()" constraint="count(/data/members[relationship_to_head = 'SELF']) = 1 and count(/data/members) &gt;= 1" jr:constraintMsg="Check this answer before continuing." /><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" calculate="concat('uuid:', uuid())" /></model></h:head><h:body><group ref="/data/visit"><label>Sponsor, consent and enumerator</label><input ref="/data/visit/sponsor_name"><label>Sponsor</label></input><input ref="/data/visit/respondent_name"><label>Respondent name</label></input><input ref="/data/visit/enumerator_name"><label>Enumerator name</label></input><select1 ref="/data/visit/consent_status"><label>Has informed consent been given?</label><item><label>Yes</label><value>YES</value></item><item><label>No — stop the interview</label><value>NO</value></item></select1><input ref="/data/visit/survey_community"><label>Community or region (optional)</label></input></group><group ref="/data/household"><label>Household details</label><input ref="/data/household/record_name"><label>Household name</label></input><input ref="/data/household/address_line_1"><label>Address (optional)</label></input><input ref="/data/household/coordinates"><label>GPS coordinates (optional)</label></input></group><group><label>Household members</label><repeat nodeset="/data/members"><input ref="/data/members/first_name"><label>First name</label></input><input ref="/data/members/last_name"><label>Last name</label></input><select1 ref="/data/members/gender"><label>Sex</label><item><label>Male</label><value>MALE</value></item><item><label>Female</label><value>FEMALE</value></item><item><label>Other</label><value>OTHER</value></item><item><label>Unknown</label><value>UNKNOWN</value></item></select1><input ref="/data/members/birth_date"><label>Date of birth (leave blank if unknown)</label></input><input ref="/data/members/estimated_age"><label>Age when date of birth is unknown</label></input><select1 ref="/data/members/relationship_to_head"><label>Relationship to household head</label><item><label>Household head</label><value>SELF</value></item><item><label>Spouse</label><value>SPOUSE</value></item><item><label>Child</label><value>CHILD</value></item><item><label>Parent</label><value>PARENT</value></item><item><label>Sibling</label><value>SIBLING</value></item><item><label>Other Relative</label><value>OTHER_RELATIVE</value></item><item><label>Non Relative</label><value>NON_RELATIVE</value></item></select1><input ref="/data/members/foundational_id"><label>National ID (optional; authentication is not connected)</label></input></repeat></group><group ref="/data/living"><label>Living conditions and income (optional)</label><input ref="/data/living/rooms_count"><label>Number of rooms</label></input><input ref="/data/living/monthly_household_income"><label>Monthly household income</label></input><input ref="/data/living/income_source"><label>Main income source</label></input><select1 ref="/data/living/health_insurance_status"><label>Health insurance</label><item><label>Yes</label><value>YES</value></item><item><label>No</label><value>NO</value></item><item><label>Unknown</label><value>UNKNOWN</value></item></select1><select1 ref="/data/living/tenure_status"><label>Housing tenure</label><item><label>Owned</label><value>OWNED</value></item><item><label>Rented</label><value>RENTED</value></item><item><label>Shared</label><value>SHARED</value></item><item><label>Other</label><value>OTHER</value></item></select1></group><group><label>Household assets (optional)</label><repeat nodeset="/data/assets"><select1 ref="/data/assets/asset_type"><label>Asset type</label><item><label>Land</label><value>LAND</value></item><item><label>Livestock</label><value>LIVESTOCK</value></item><item><label>Productive Tool</label><value>PRODUCTIVE_TOOL</value></item><item><label>Consumer Durable</label><value>CONSUMER_DURABLE</value></item><item><label>Vehicle</label><value>VEHICLE</value></item><item><label>Other</label><value>OTHER</value></item></select1><input ref="/data/assets/asset_category"><label>Asset description</label></input><input ref="/data/assets/quantity"><label>Quantity</label></input></repeat></group><group ref="/data/review"><label>Review and confirmation</label><select1 ref="/data/review/confirmation"><label>I have reviewed these answers and confirm they are ready for submission.</label><item><label>Reviewed and confirmed</label><value>YES</value></item></select1></group></h:body></h:html>
