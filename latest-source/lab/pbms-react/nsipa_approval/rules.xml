<odoo>
 <record id="list_program_scope" model="ir.rule"><field name="name">NSIPA lists follow programme membership</field><field name="model_id" ref="g2p_pbms.model_g2p_beneficiary_list"/><field name="domain_force">[(1,'=',1)] if user.has_group('g2p_pbms.group_program_super_administration') else ['|',('program_id.nsipa_flow','=',False),('program_id.program_mnemonic','in',user.groups_id.mapped('name'))]</field></record>
 <record id="line_program_scope" model="ir.rule"><field name="name">NSIPA beneficiary programme scope</field><field name="model_id" ref="model_nsipa_approval_line"/><field name="domain_force">[(1,'=',1)] if user.has_group('g2p_pbms.group_program_super_administration') else [('list_id.program_id.program_mnemonic','in',user.groups_id.mapped('name'))]</field></record>
 <record id="event_program_scope" model="ir.rule"><field name="name">NSIPA evidence programme scope</field><field name="model_id" ref="model_nsipa_approval_event"/><field name="domain_force">[(1,'=',1)] if user.has_group('g2p_pbms.group_program_super_administration') else [('list_id.program_id.program_mnemonic','in',user.groups_id.mapped('name'))]</field></record>
 <record id="stage_program_scope" model="ir.rule"><field name="name">NSIPA stage programme scope</field><field name="model_id" ref="model_nsipa_approval_stage"/><field name="domain_force">[(1,'=',1)] if user.has_group('g2p_pbms.group_program_super_administration') else [('program_id.program_mnemonic','in',user.groups_id.mapped('name'))]</field></record>
</odoo>
